# LLM 配置（DEEPSEEK 优先，未配置时回落到 OPENAI）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# Agent 运行参数
AGENT_LLM_MODEL=deepseek-chat
AGENT_MAX_ITERATIONS=8

# 数据源
TUSHARE_TOKEN=
AKSHARE_DISABLE_PROXY=1
DDGS_REGION=
DDGS_DISABLE_PROXY=

# 后端服务
FLASK_PORT=5001
FLASK_DEBUG=0
FLASK_USE_RELOADER=0
LOG_LEVEL=INFO

# 前端请求的后端地址（也可用 run.py --frontend --api-url 覆盖）
VITE_API_BASE_URL=http://localhost:5001
