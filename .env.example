# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# OpenAI/DeepSeek API配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4

# DeepSeek配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 编排器模式: auto|langchain|custom
AGENT_ORCHESTRATOR=auto

# 数据收集Agent并行执行: true|false
AGENT_PARALLEL=true

# 并行执行超时（秒）
AGENT_PARALLEL_TIMEOUT=30

# 数据库配置
DATABASE_URL=sqlite:///ai_investment.db

# V2 Agent 配置
AGENT_V2_ENABLED=false
AGENT_V2_DEFAULT=true
AGENT_V2_DEBUG=false
AGENT_V2_MAX_ITERATIONS=6
AGENT_V2_TOOL_TIMEOUT=20
AGENT_V2_REQUIRE_CRITIC=true
AGENT_V2_REQUIRE_COMPLIANCE=true
